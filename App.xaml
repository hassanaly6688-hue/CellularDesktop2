<Application x:Class="CellularDesktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CellularDesktop.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="SubtleBrush" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="BorderBrush2" Color="#E5E7EB"/>
        <views:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <views:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <views:DirectionToAlignmentConverter x:Key="DirectionToAlignmentConverter"/>
    </Application.Resources>
</Application>
