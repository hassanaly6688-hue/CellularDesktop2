<Window x:Class="CellularDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cellular Desktop" Height="720" Width="1100" MinWidth="760" MinHeight="480"
        FontFamily="Segoe UI">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Status bar -->
        <Border Grid.Row="0" Background="{StaticResource SubtleBrush}" Padding="12,8" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Connect modem" Command="{Binding ConnectCommand}" Padding="10,4"/>
                <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                         Fill="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}}"/>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- Incoming call banner -->
        <Border Grid.Row="1" Background="#FEF3C7" Padding="12,8" Visibility="{Binding HasIncomingCall, Converter={StaticResource BoolToVisibilityConverter}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Answer" Command="{Binding AnswerCommand}" Margin="0,0,8,0" Padding="10,4" Background="#16A34A" Foreground="White"/>
                    <Button Content="Decline" Command="{Binding HangUpCommand}" Padding="10,4" Background="#DC2626" Foreground="White"/>
                </StackPanel>
                <TextBlock Text="{Binding IncomingCallBanner}" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="2" Margin="8">

            <!-- SMS TAB -->
            <TabItem Header="Messages">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Column="0" ItemsSource="{Binding ThreadNumbers}" Margin="0,0,8,0"
                              SelectionChanged="ThreadList_SelectionChanged"/>

                    <DockPanel Grid.Column="1">
                        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding ComposeNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" ToolTip="Phone number"/>
                                <TextBox Grid.Column="1" Text="{Binding ComposeBody, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" ToolTip="Message"/>
                                <Button Grid.Column="2" Content="Send" Command="{Binding SendSmsCommand}" Padding="14,4"/>
                            </Grid>
                        </Border>
                        <ListBox ItemsSource="{Binding ActiveThread}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8" Margin="0,3" CornerRadius="6"
                                            Background="{StaticResource SubtleBrush}"
                                            HorizontalAlignment="{Binding Direction, Converter={StaticResource DirectionToAlignmentConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Body}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:g}'}" FontSize="10" Foreground="Gray" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding Status}" FontSize="10" Foreground="Gray"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- DIALER TAB -->
            <TabItem Header="Dialer">
                <StackPanel MaxWidth="360" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBox Text="{Binding DialNumber, UpdateSourceTrigger=PropertyChanged}" FontSize="22" HorizontalContentAlignment="Center" Margin="0,0,0,16" Padding="6"/>
                    <UniformGrid Columns="2" Rows="1">
                        <Button Content="Call" Command="{Binding DialCommand}" Background="#16A34A" Foreground="White" Margin="4" Padding="0,10" FontSize="14"/>
                        <Button Content="Hang up" Command="{Binding HangUpCommand}" Background="#DC2626" Foreground="White" Margin="4" Padding="0,10" FontSize="14"/>
                    </UniformGrid>
                    <TextBlock Text="{Binding IsInCall, StringFormat='In call: {0}'}" HorizontalAlignment="Center" Margin="0,12,0,0" Foreground="Gray"/>
                </StackPanel>
            </TabItem>

            <!-- CALL LOG TAB -->
            <TabItem Header="Call Log">
                <ListView ItemsSource="{Binding CallLog}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Number" DisplayMemberBinding="{Binding PhoneNumber}" Width="180"/>
                            <GridViewColumn Header="Direction" DisplayMemberBinding="{Binding Direction}" Width="100"/>
                            <GridViewColumn Header="Result" DisplayMemberBinding="{Binding Result}" Width="100"/>
                            <GridViewColumn Header="Duration" DisplayMemberBinding="{Binding Duration}" Width="120"/>
                            <GridViewColumn Header="When" DisplayMemberBinding="{Binding Timestamp, StringFormat='{}{0:g}'}" Width="160"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>

            <!-- CONTACTS TAB -->
            <TabItem Header="Contacts">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Content="Add contact" Command="{Binding AddContactCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" Padding="10,4"/>
                    <ListView ItemsSource="{Binding Contacts}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" DisplayMemberBinding="{Binding DisplayName}" Width="200"/>
                                <GridViewColumn Header="Phone number" DisplayMemberBinding="{Binding PhoneNumber}" Width="200"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
